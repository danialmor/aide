name = "aide-online-api"
main = "worker.js"
compatibility_date = "2026-10-26"

[[d1_databases]]
binding = "DB"
database_name = "aide-online"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"

[vars]
APP_ORIGIN = "https://aide.example.com" # Replace with the exact deployed frontend origin
# Set ADMIN_BOOTSTRAP_KEY with: npx wrangler secret put ADMIN_BOOTSTRAP_KEY
